analyze -f VHDL -lib WORK ../src/Adder.vhd
analyze -f VHDL -lib WORK ../src/Mult.vhd
analyze -f VHDL -lib WORK ../src/FF.vhd
analyze -f VHDL -lib WORK ../src/REG11B.vhd
analyze -f VHDL -lib WORK ../src/myfir.vhd
analyze -f VHDL -lib WORK ../src/AddMultBlockV2.vhd
analyze -f VHDL -lib WORK ../tb/clk_gen.vhd
analyze -f VHDL -lib WORK ../tb/data_maker.vhd
analyze -f VHDL -lib WORK ../tb/data_sink.vhd
elaborate myfir -arch STRUCTURAL -lib WORK
create_clock -name MY_CLK -period 7.6 clk
set_dont_touch_network MY_CLK
set_clock_uncertainty 0.07 [get_clocks MY_CLK]
set_input_delay 0.5 -max -clock MY_CLK [remove_from_collection [all_inputs] clk]
set_output_delay 0.5 -max -clock MY_CLK[all_outputs]
set OLOAD [load_of NangateOpenCellLibrary/BUF_X4/A]
set_load $OLOAD [all_outputs]
compile -gate_clock
report_timing > reportTiming.txt
report_area > reportArea.txt
ungroup -all -flatten
change_names -hierarchy -rules verilog
write_sdf ../netlist/myfir.sdf
write -f verilog -hierarchy -output ../netlist/myfir.v
write_sdc ../netlist/myfir.sdc

